# ~/.hermes/.env   — copy to .env and fill in. NEVER commit this file.
# chmod 600 ~/.hermes/.env  after creating it.

# --- Local model (values are placeholders; the local server ignores the key) --
LOCAL_MODEL_KEY=local-anything

# --- Telegram --------------------------------------------------------------
# Create a bot with @BotFather -> /newbot, paste the token below.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Your NUMERIC user id (NOT your @username). Get it by messaging @userinfobot.
# Keep this to ONLY your id so nobody else can command the agent.
TELEGRAM_ALLOWED_USERS=123456789

# --- Google (Calendar + Gmail) --------------------------------------------
# Path to the OAuth client credentials JSON you download from Google Cloud
# Console (Desktop app OAuth client). Do the consent flow once at setup.
GOOGLE_OAUTH_CREDENTIALS=/Users/YOU/.hermes/secrets/google_oauth.json

# --- Discord (phase 1, gateway platform) -----------------------------------
# Create an app + bot at https://discord.com/developers, copy the bot token.
DISCORD_BOT_TOKEN=your-discord-bot-token
# Restrict to your own guild/channel ids (comma-separated) for safety.
DISCORD_ALLOWED_CHANNELS=

# --- Notion (phase 2) ------------------------------------------------------
# NOTION_TOKEN=secret_xxx
